# ==============================================================================
# GroupBuying / PoolBuy India — Environment Configuration Template
# ==============================================================================

# Public, canonical absolute URL. Use http://localhost:3000 for local development.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ------------------------------------------------------------------------------
# Supabase Configuration (Required when NEXT_PUBLIC_DEMO_MODE=false)
# Note: Remote Supabase is NOT VERIFIED until active project credentials are provided.
# ------------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-key
# Legacy fallback if your project uses anon key:
# NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# Server-only Supabase Service Role Key. NEVER prefix this with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# ------------------------------------------------------------------------------
# Admin Console Authentication
# ------------------------------------------------------------------------------
# Admin passkey for constant-time HMAC authentication at /admin/login
ADMIN_PASSKEY=choose-a-strong-passkey-here

# 32+ character random secret used to sign admin session HMAC cookies
ADMIN_SESSION_SECRET=at-least-32-random-alphanumeric-secret-key-here

# ------------------------------------------------------------------------------
# Automated Cron / Task Scheduler Security
# ------------------------------------------------------------------------------
# Secret token for authenticating automated cron/scheduler tasks (/api/cron/pool-lifecycle)
# Must match Authorization: Bearer <CRON_SECRET> header or ?secret=<CRON_SECRET>
CRON_SECRET=your-random-32-or-48-char-hex-secret-here

# ------------------------------------------------------------------------------
# Development Switches & Optional Contact Overrides
# ------------------------------------------------------------------------------
# Set to true for offline local development (uses in-memory demo mock data store).
NEXT_PUBLIC_DEMO_MODE=true

# Optional operator contact values. Populate only with real, approved contact details.
NEXT_PUBLIC_SUPPORT_WHATSAPP=
NEXT_PUBLIC_SUPPORT_EMAIL=
